<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Third-party licenses — GOD Toolkit</title>
  <style>
    body { font: 15px/1.5 -apple-system, BlinkMacSystemFont, sans-serif; margin: 2rem auto; max-width: 900px; padding: 0 1rem; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f5f5f7; padding: 1rem; }
    li { margin: .35rem 0; }
  </style>
</head>
<body>
  <h1>Third-party licenses</h1>
  <p>This notice lists licenses for the Rust crates included in the bundled iso2god converter distributed with GOD Toolkit. The application and converter license files are included separately.</p>
  <h2>License summary</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  <h2>License texts</h2>
  {{#each licenses}}
  <section>
    {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
    <h4>{{name}}</h4>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
